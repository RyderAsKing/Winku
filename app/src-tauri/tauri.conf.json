{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Winku",
  "version": "0.0.1",
  "identifier": "app.winku",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run ui:dev",
    "beforeBuildCommand": "bun run ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Winku",
        "url": "index.html",
        "width": 140,
        "height": 84,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/winku-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
