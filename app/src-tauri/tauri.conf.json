{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Winku",
  "version": "0.1.5",
  "identifier": "app.winku",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run ui:dev",
    "beforeBuildCommand": "bun run ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Winku",
        "url": "index.html",
        "width": 140,
        "height": 84,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/winku-engine",
      "binaries/agent-desktop"
    ],
    "resources": {
      "licenses/agent-desktop.txt": "licenses/agent-desktop.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RyderAsKing/Winku/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENjJBQjgwN0ZCOTFGQzQKUldURUg3bC9nS3RpVFd5Y0JWN3JtUlY5dGl6ODg1R2Z2L3dtOGpKOWg3eHdDWjZkaE1kM0k2RGQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
